  "subSubcategories": {
    "数据结构|栈|前缀最值": {
      "description": "通过辅助数组记录从栈底到各位置的最大值，实现O(1)最值查询。"
    },
    "数据结构|栈|单调栈": {
      "description": "维护栈内元素单调性（递增或递减），当新元素破坏单调性时弹出栈顶。每个元素最多入栈出栈各一次，总复杂度O(n)。"
    },
    "数据结构|并查集|基础": {
      "description": "基础并查集，仅路径压缩或按秩合并，适用于简单的连通性维护。"
    },
    "数据结构|并查集|带权": {
      "description": "带权并查集，在路径压缩时维护节点间的权值关系（如距离、偏移量），适用于食物链等关系传递问题。"
    },
    "数据结构|并查集|扩展域": {
      "description": "扩展域并查集（种类并查集），通过为每个实体建立多个域（如自身、敌人、猎物）来处理复杂的对立/关系约束。"
    },
    "数据结构|前缀和与差分|一维": {
      "description": "一维序列上的前缀和与差分，支持O(1)区间求和与O(1)区间修改。"
    },
    "数据结构|前缀和与差分|二维": {
      "description": "二维矩阵上的前缀和与差分，支持O(1)子矩阵求和与O(1)子矩阵修改。"
    },
    "数据结构|前缀和与差分|树上": {
      "description": "树结构上的前缀和与差分，利用LCA实现路径点权/边权的O(1)查询与修改。"
    },
    "动态规划|背包问题|01背包": {
      "description": "每件物品最多选一次的背包问题，是所有背包变体的基础。涵盖标准版、二维费用、路径记录、方案计数等扩展。"
    },
    "动态规划|背包问题|完全背包": {
      "description": "每件物品可选无限次的背包问题，通过01背包的逆序遍历改为正序遍历即可转换。"
    },
    "动态规划|背包问题|多重背包": {
      "description": "每件物品有数量上限的背包问题，需用二进制优化或单调队列优化将O(nm)降为O(nm log s)或O(nm)。"
    },
    "动态规划|背包问题|分组背包": {
      "description": "物品分为若干组，每组最多选一件的背包问题，是泛化背包模型，需在组内做互斥决策。"
    },
    "动态规划|线性DP|LCS": {
      "description": "最长公共子序列与最长公共子串问题，通过二维状态转移实现O(nm)求解，可扩展路径还原。"
    },
    "动态规划|线性DP|LIS": {
      "description": "最长上升子序列问题，朴素DP为O(n²)，二分优化为O(n log n)，树状数组优化可同时计数方案数。"
    },
    "动态规划|线性DP|经典模型": {
      "description": "线性DP中的经典问题，包括编辑距离、最大子段和、数字三角形等基础模型，是DP入门必学。"
    },
    "动态规划|状态压缩DP|路径问题": {
      "description": "用状压DP求解路径覆盖类问题，如Hamilton路径、旅行商问题(TSP)。状态为已访问点集+当前位置，转移枚举前驱点。"
    },
    "图论|最短路|单源最短路": {
      "description": "求从单一源点到其他所有顶点的最短路径。Dijkstra适用于非负权图，Bellman-Ford和SPFA可处理负权边。"
    },
    "图论|最短路|全源最短路": {
      "description": "求所有顶点对之间的最短路径。Floyd基于传递闭包O(n³)，Johnson结合Dijkstra与Bellman-Ford处理含负权的全源问题。"
    },
    "图论|最短路|DAG最短路": {
      "description": "在有向无环图上通过拓扑排序求最短路，时间复杂度O(n+m)，是所有最短路算法中最优的，且支持负权边。"
    }
  }
}